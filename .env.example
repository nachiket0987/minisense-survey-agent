# Export these variables in your shell; no .env loader is required.
MINISENSE_PROVIDER=demo
# For an existing local OpenAI-compatible server:
MINISENSE_BASE_URL=http://localhost:11434/v1
MINISENSE_MODEL=your-installed-tool-capable-model
# Set only if your endpoint requires authentication; never commit it.
MINISENSE_API_KEY=
# Tested hosted alternative, subject to approved quota/budget:
# MINISENSE_BASE_URL=https://api.groq.com/openai/v1
# MINISENSE_MODEL=openai/gpt-oss-20b
# Map GROQ_API_KEY to MINISENSE_API_KEY in the same execution shell; never echo it.
MINISENSE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
